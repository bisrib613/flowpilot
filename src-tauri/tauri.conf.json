{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowpilot",
  "version": "1.3.0",
  "identifier": "com.flowpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Flowpilot",
      "width": 1180,
      "height": 780,
      "minWidth": 540,
      "minHeight": 620,
      "resizable": true,
      "center": true,
      "decorations": true,
      "theme": "Dark"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRjk4NDhFOTFBNUVDODMKUldTRDdLV1Jqb1Q1VWtCbTR1c0VRY052STVDY25LZ3hNUkV5NmNpTXFtSUNxdHg3ZlVWUjB3VXgK",
      "endpoints": ["https://github.com/bisrib613/flowpilot/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
