{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for Flowpilot",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-get-download-folder",
    "allow-choose-download-folder",
    "allow-open-download-folder",
    "allow-open-google-flow",
    "allow-prepare-workspace",
    "allow-preload-workspace",
    "allow-close-workspaces",
    "allow-close-google-flow",
    "allow-resize-google-flow",
    "allow-navigate-service-bookmark",
    "allow-remove-google-flow-account",
    "allow-clear-google-flow-cache",
    "allow-load-accounts",
    "allow-save-accounts",
    "allow-debug-trigger-isolated-dialog"
  ]
}
